<div class="fixed inset-0 z-[60] flex justify-end">
    <button type="button"
            class="absolute inset-0 cursor-default border-0 bg-slate-950/30"
            @onclick="OnClose"
            aria-label="Fechar painel">
    </button>

    <aside class="relative z-[61] flex h-full w-full flex-col bg-white shadow-xl sm:w-[540px]">
        <header class="flex shrink-0 items-start justify-between border-b border-soft px-6 py-5">
            <div class="min-w-0">
                <h2 class="text-xl font-bold text-primary">@Title</h2>
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <p class="mt-0.5 truncate text-sm font-semibold text-muted">@Subtitle</p>
                }
            </div>
            <button type="button"
                    class="ml-4 shrink-0 rounded-xl border-soft bg-white p-2 text-secondary transition-all hover:bg-surface hover:text-primary"
                    @onclick="OnClose"
                    aria-label="Fechar">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M18 6L6 18M6 6l12 12" stroke-linecap="round" />
                </svg>
            </button>
        </header>

        @if (Tabs is { Count: > 0 })
        {
            <nav class="flex shrink-0 gap-1 overflow-x-auto border-b border-soft px-4 py-2">
                @foreach (var tab in Tabs)
                {
                    var isActive = tab.Id == ActiveTabKey;
                    <button type="button"
                            class="@(isActive ? "bg-surface text-primary" : "text-secondary hover:bg-surface hover:text-primary") flex items-center gap-2 whitespace-nowrap rounded-lg px-3 py-2 text-xs font-semibold transition-all"
                            @onclick="() => OnTabChanged.InvokeAsync(tab.Id)">
                        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                            @((MarkupString)tab.IconSvgPath)
                        </svg>
                        @tab.Label
                    </button>
                }
            </nav>
        }

        <div class="flex-1 overflow-y-auto px-6 py-5">
            @ChildContent
        </div>

        <footer class="flex shrink-0 items-center justify-end gap-2 border-t border-soft px-6 py-4">
            <button type="button"
                    class="rounded-xl border-soft bg-white px-4 py-2 text-sm font-semibold text-secondary transition-all hover:bg-surface hover:text-primary"
                    disabled="@IsSaving"
                    @onclick="OnClose">
                Cancelar
            </button>
            <button type="submit"
                    form="@FormId"
                    class="rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-on-dark transition-all hover:bg-[#3A6391] disabled:cursor-not-allowed disabled:opacity-60"
                    disabled="@IsSaving">
                @(IsSaving ? "Salvando..." : "Salvar")
            </button>
        </footer>
    </aside>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public IReadOnlyList<SidePanelTab>? Tabs { get; set; }
    [Parameter] public string? ActiveTabKey { get; set; }
    [Parameter] public EventCallback<string> OnTabChanged { get; set; }
    [Parameter] public bool IsSaving { get; set; }
    [Parameter] public string FormId { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
