@page "/historia/{EmpresaId:guid}"
@using SistemaBensServicosTur.Web.Features.EmpresaHistoria
@inject EmpresaHistoriaService EmpresaHistoriaService
@inject NavigationManager Navigation

<PageTitle>História da empresa</PageTitle>

<div class="mx-auto max-w-[960px] space-y-5">
    @if (_loading)
    {
        <section class="rounded-[var(--radius-xl)] border-soft bg-white p-6 shadow-sm">
            <p class="text-sm font-semibold text-muted">Carregando história...</p>
        </section>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <section class="rounded-[var(--radius-xl)] border border-red-200 bg-red-50 p-6 text-sm font-semibold text-red-800 shadow-sm">
            @_errorMessage
        </section>
        <button type="button" class="rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-on-dark transition-all hover:bg-[#3A6391]" @onclick="VoltarParaEmpresas">Voltar</button>
    }
    else if (_empresa is null)
    {
        <section class="rounded-[var(--radius-xl)] border-soft bg-white p-6 shadow-sm">
            <p class="text-sm font-semibold text-muted">Empresa não encontrada.</p>
        </section>
        <button type="button" class="rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-on-dark transition-all hover:bg-[#3A6391]" @onclick="VoltarParaEmpresas">Voltar</button>
    }
    else
    {
        <header class="rounded-[var(--radius-xl)] border-soft bg-white p-6 shadow-sm">
            <h1 class="text-2xl font-bold text-primary">@_empresa.NomeEmpresa</h1>
            <p class="mt-1 text-sm font-semibold text-muted">@ObterTextoOuPadrao(_empresa.CidadeTenant?.Nome ?? _empresa.Cidade, "Cidade não informada")</p>
        </header>

        <section class="rounded-[var(--radius-xl)] border-soft bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-primary">História</h2>
            <p class="mt-3 whitespace-pre-wrap text-sm leading-6 text-main">@ObterTextoOuPadrao(_empresa.Historia, "História não informada.")</p>
        </section>

        <section class="rounded-[var(--radius-xl)] border-soft bg-white p-6 shadow-sm">
            <h2 class="text-lg font-bold text-primary">Fotos</h2>

            @if (_fotoUrls.Count == 0)
            {
                <p class="mt-3 text-sm font-semibold text-muted">Nenhuma foto cadastrada.</p>
            }
            else
            {
                <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var fotoUrl in _fotoUrls)
                    {
                        <div class="overflow-hidden rounded-xl border-soft bg-surface">
                            <img src="@fotoUrl" alt="@($"Foto de {_empresa.NomeEmpresa}")" loading="lazy" class="h-48 w-full object-cover" />
                        </div>
                    }
                </div>
            }
        </section>

        <button type="button" class="rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-on-dark transition-all hover:bg-[#3A6391]" @onclick="VoltarParaEmpresas">Voltar para empresas</button>
    }
</div>
