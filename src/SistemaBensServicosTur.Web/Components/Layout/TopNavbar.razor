@using Microsoft.AspNetCore.Components.Authorization
@using SistemaBensServicosTur.Web.Components.Shared
@using SistemaBensServicosTur.Web.Infrastructure.Security
@inject DashboardActions DashboardActions
@inject NavigationManager Navigation
@implements IDisposable

<header class="sticky top-0 z-50 w-full border-b border-[#D1D1D4] bg-white">
    <div class="mx-auto flex w-full max-w-[1440px] items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class="flex shrink-0 items-center gap-3 no-underline">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary">
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.6">
                    <path d="M12 13.5a3 3 0 100-6 3 3 0 000 6z" />
                    <path d="M19.5 10.5c0 6.188-7.5 12-7.5 12s-7.5-5.813-7.5-12a7.5 7.5 0 1115 0z" />
                </svg>
            </span>
            <span class="hidden flex-col sm:flex">
                <img width="180px" src="https://static.wixstatic.com/media/7f3263_d28beb3921404d498bfa864b7252437e~mv2.png/v1/fill/w_408,h_50,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/oi-8.png" alt="Logo" />
            </span>
        </a>

        <nav class="hidden items-center gap-1 md:flex">
            <a href="/" class="@NavClass("/")">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="7" height="7" rx="1" />
                    <rect x="14" y="3" width="7" height="7" rx="1" />
                    <rect x="3" y="14" width="7" height="7" rx="1" />
                    <rect x="14" y="14" width="7" height="7" rx="1" />
                </svg>
                <span>Bens e Serviços</span>
            </a>
            <a href="/mapa" class="@NavClass("/mapa")">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="11" cy="11" r="7" />
                    <path d="M21 21l-4-4" stroke-linecap="round" />
                </svg>
                <span>Mapa</span>
            </a>
            <a href="/roteiros" class="@NavClass("/roteiros")">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 6l6-3 6 3 6-3v15l-6 3-6-3-6 3V6z" stroke-linejoin="round" />
                    <path d="M9 3v15M15 6v15" />
                </svg>
                <span>Roteiros</span>
            </a>
            <a href="/relatorios" class="@NavClass("/relatorios")">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M3 3v18h18" stroke-linecap="round" stroke-linejoin="round" />
                    <path d="M7 14l4-4 4 4 6-6" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <span>Relatórios</span>
            </a>
            <AuthorizeView Roles="@AuthConstants.Roles.Admin">
                <Authorized>
                    <a href="/admin" class="@NavClass("/admin")">
                        <span>Admin</span>
                    </a>
                </Authorized>
            </AuthorizeView>
        </nav>

        <AuthorizeView Context="authState">
            <Authorized>
                <div class="flex items-center gap-2 sm:gap-3">
                    <button type="button" @onclick="ToggleMobileMenu" class="flex items-center justify-center rounded-lg p-2 text-secondary md:hidden">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
                        </svg>
                    </button>

                    @if (_cidadeFilterState.IsAdmin && _cidadeFilterState.CidadesDisponiveis.Count > 0)
                    {
                        <div class="sm:block">
                            <select
                                class="rounded-lg border-soft bg-white px-2 py-1.5 text-xs font-semibold text-secondary transition-all hover:bg-surface hover:text-primary focus:border-primary focus:outline-none focus:ring-1 focus:ring-primary"
                                value="@_cidadeFilterState.CidadeSelecionadaId"
                                @onchange="OnCidadeChangedAsync">
                                <option value="">Selecione uma cidade</option>
                                @foreach (var cidade in _cidadeFilterState.CidadesDisponiveis)
                                {
                                    <option value="@cidade.Id">@cidade.Nome</option>
                                }
                            </select>
                        </div>
                    }

                    <div class="hidden items-center gap-2 rounded-full border-soft bg-white py-1 pl-1 pr-2 sm:flex sm:pr-3">
                        <span class="flex h-8 w-8 items-center justify-center rounded-full bg-surface text-xs font-bold text-primary">@GetInitials(authState.User.Identity?.Name)</span>
                        <span class="hidden text-sm font-semibold text-main lg:block">@GetDisplayName(authState.User.Identity?.Name)</span>
                    </div>

                    <form method="post" action="/auth/logout" class="m-0">
                        <button type="submit" class="rounded-xl border-soft bg-white px-3 py-2 text-sm font-semibold text-secondary transition-all hover:bg-surface hover:text-primary">
                            Sair
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <a href="/login" class="rounded-xl bg-primary px-4 py-2 text-sm font-semibold text-on-dark no-underline transition-all hover:bg-[#3A6391]">
                    Entrar
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>

    @if (_mobileMenuOpen)
    {
        <nav class="flex flex-col gap-1 border-t border-soft bg-white px-4 py-3 md:hidden">
            <a href="/" class="@MobileNavClass("/")">
                <span>Cadastros</span>
            </a>
            <a href="/mapa" class="@MobileNavClass("/mapa")">
                <span>Mapa</span>
            </a>
            <a href="/roteiros" class="@MobileNavClass("/roteiros")">
                <span>Roteiros</span>
            </a>
            <a href="/relatorios" class="@MobileNavClass("/relatorios")">
                <span>Relatórios</span>
            </a>
            <AuthorizeView Roles="@AuthConstants.Roles.Admin">
                <Authorized>
                    <a href="/admin" class="@MobileNavClass("/admin")">
                        <span>Admin</span>
                    </a>
                </Authorized>
            </AuthorizeView>
        </nav>
    }
</header>
